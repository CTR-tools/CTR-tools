<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
	<UseWindowsForms>true</UseWindowsForms>
	<TargetFramework>net8.0-windows7.0</TargetFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'" />

  <ItemGroup>
    <None Remove="Data\ctr_drumfill.mid" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Data\ctr_drumfill.mid" />
    <EmbeddedResource Include="Data\Data.zip" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Crc32.NET" Version="1.2.0" />
    <PackageReference Include="NAudio" Version="2.4.0" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <SubType>Designer</SubType>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
      <Generator>PublicResXFileCodeGenerator</Generator>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="PreBuild" BeforeTargets="PreBuildEvent">
    <Exec Command="echo %25date%25 %25time%25 &gt; &quot;$(ProjectDir)\Properties\BuildDate.txt&quot;&#xD;&#xA;&quot;$(ProjectDir)\Data\smallzip.exe&quot; -w -i  &quot;$(ProjectDir)\Data&quot; -o &quot;$(ProjectDir)\Data\data.zip&quot; -f *.txt&#xD;&#xA;&quot;$(ProjectDir)\Data\smallzip.exe&quot; -w -i &quot;$(ProjectDir)\Data&quot; -o &quot;$(ProjectDir)\Data\data.zip&quot; -f *.xml&#xD;&#xA;&quot;$(ProjectDir)\Data\smallzip.exe&quot; -w -i &quot;$(ProjectDir)\Data&quot; -o &quot;$(ProjectDir)\Data\data.zip&quot; -f *.json" />
  </Target>

</Project>
